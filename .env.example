# Trunk Legal Git - Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Google OAuth Configuration
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# REQUIRED: Security Keys
# Generate a secure random key: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-this

# Database Configuration
# Default uses SQLite (recommended for self-hosting)
DATABASE_URL=sqlite:////data/db/trunk.db

# Server Configuration
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# CORS Configuration (add your domain)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional: Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: Advanced Settings
# LOG_LEVEL=INFO
# MAX_UPLOAD_SIZE=52428800  # 50MB default
# SESSION_TIMEOUT=3600      # 1 hour default
# RATE_LIMIT_PER_HOUR=100   # API rate limit

# Docker-specific paths (don't change unless you know what you're doing)
DATA_PATH=/data
REPOS_PATH=/data/repos
LOGS_PATH=/data/logs
