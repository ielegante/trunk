{
  "manifest_version": 3,
  "name": "Legal Git",
  "version": "0.1.0",
  "description": "Git-level version control for legal document management in Google Drive",
  "permissions": [
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://drive.google.com/*",
    "https://docs.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/*",
        "https://docs.google.com/*"
      ],
      "js": ["git-operations.js", "commit-ui.js", "enhanced-content-script.js", "content-script.js"],
      "css": ["styles.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Legal Git",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected-scripts/*"],
      "matches": ["https://drive.google.com/*", "https://docs.google.com/*"]
    }
  ]
}
